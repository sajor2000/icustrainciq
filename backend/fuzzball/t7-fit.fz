version: v4
# SUPERSEDED by workflows/job_4_probe (in github.com/vaishvikc/ICU-Twin), which fits the same probe beside the model it
# belongs to (/data/model_output/final/probe.joblib + probe_src/). t7-forecast reads that
# one, so this workflow is a fallback: run it only if job 4 has not produced a probe.

# t7-fit: the ONE-TIME step between t7-code and the first forecast (docs/LIVE_DEMO.md G2, G3). Run it once
# after t7-code has published the code and training has packaged a model, and again only when the model
# changes. A forecast update never refits.
# TEMPLATE (Fuzzball 4.3 has no parameters): two ward tokens are replaced before the start,
#   @CLIF_DIR@   CLIF folder of the stage ward: /store/code/clif_demo (the open demo) by default; for the final
#                cohort /data/dashboard_data (volume mimic_clif, read only). Never the repo.
#   @WARD_IDS@   empty by default (stage_ward.py selects 25 open-demo stays); for the final cohort
#                "--ward-ids /data/dashboard_data/dashboard_patients_unit25.parquet --real-ward"
#   python scripts/render_fz.py fuzzball/t7-fit.fz -o /tmp/t7-fit.fz              # defaults: the open demo
#   python scripts/render_fz.py fuzzball/t7-fit.fz --cohort -o /tmp/t7-fit.fz     # the final cohort (= fuzzball/ready/t7-fit.fz)
#   fuzzball workflow validate /tmp/t7-fit.fz && fuzzball workflow start /tmp/t7-fit.fz --name t7-fit
# Jobs: tokens (CPU: a view of the training tokens on twin-store, winnowed at 24 h), stage (CPU: the 25
# stage-ward stays, tokenized and winnowed, vocabulary check), extract (one GPU: features for train, tuning and
# held_out), fit (CPU: logistic probes, saved to twin-store).
# The extract uses ONE GPU (the dispatcher refuses updates while a t7-fit runs, so the GPU is free).
# Prints counts only; no patient rows.
#
# Storage (docs/FUZZBALL_VALIDATION.md): mimic_clif is training's volume and is only READ here: the model
# (/data/model_output/final), the training tokens (/data/tokenized_output) and the cohort (/data/dashboard_data).
# Everything this workflow writes goes to twin-store: /store/train (links to the training token files, plus the
# winnowed files, features and scores made here), /store/stage (the ward).
volumes:
  data:
    name: mimic_clif            # persistent, training's volume: READ ONLY here by rule (4.3 has no read-only mount)
    use: team7
  store:
    name: twin-store            # persistent: code, packages, and everything written here
    use: team7

defaults:
  job:
    mounts: {/data: data, /store: store}
    env: [HOME=/tmp, TMPDIR=/tmp, "PYTHONPATH=/store/py:/store/code"]

jobs:
  tokens:
    # CPU: /store/train is a folder of links to training's token files, so the files made from them (winnowed
    # stays, features, scores) land on twin-store and nothing is written to mimic_clif. Links only for
    # tokens_*.parquet: a file this workflow writes is never a link, so a write cannot follow one into /data.
    image: {uri: "docker://nvcr.io/nvidia/pytorch:25.11-py3"}
    resource: {cpu: {cores: 16}, memory: {size: 64GB}}
    policy: {timeout: {execute: 2h}}
    script: |
      #!/bin/bash
      set -euo pipefail
      SRC=/data/tokenized_output; MODEL=/data/model_output/final
      for f in config.json model.safetensors vocab.yaml; do
        test -f "$MODEL/$f" || { echo "no $f in $MODEL: training has not packaged a model there"; exit 1; }
      done
      test -f "$SRC/vocab.yaml" || { echo "no vocab.yaml in $SRC: no training tokens there"; exit 1; }
      # the tokens must be the ones the model was trained on
      cmp "$SRC/vocab.yaml" "$MODEL/vocab.yaml" && echo "vocab: tokens and model identical"
      test -d /store/code/icutwin || { echo "no code on twin-store: run t7-code first"; exit 1; }
      mkdir -p /store/train
      find /store/train -maxdepth 1 -type l -delete
      n=0
      for f in "$SRC"/tokens_*.parquet; do
        test -f "$f" || { echo "no tokens_*.parquet in $SRC"; exit 1; }
        ln -s "$f" "/store/train/$(basename "$f")"; n=$((n+1))
      done
      cp "$SRC/vocab.yaml" /store/train/vocab.yaml.new && mv /store/train/vocab.yaml.new /store/train/vocab.yaml
      echo "training token files linked: $n"
      # cut every training stay 24 h after ICU arrival: writes /store/train/{split}_for_inference.parquet
      python -c "from icutwin.scoring.winnower import main; main()" /store/train
      ls /store/train/*_for_inference.parquet | wc -l

  stage:
    image: {uri: "docker://nvcr.io/nvidia/pytorch:25.11-py3"}
    resource: {cpu: {cores: 8}, memory: {size: 32GB}}
    policy: {timeout: {execute: 30m}}
    script: |
      #!/bin/bash
      set -euo pipefail
      mkdir -p /store/stage && cd /store/stage
      CLIF=@CLIF_DIR@
      test -f $CLIF/clif_hospitalization.parquet || { echo "no ward CLIF folder at $CLIF"; exit 1; }
      python /store/code/app/stage_ward.py $CLIF --out /store/stage/stage_ward.csv @WARD_IDS@   # seed 20261114, 25 rooms; prints counts only
      printf 'clif_path: %s\ntimezone: US/Eastern\nfiletype: parquet\n' "$CLIF" > site.yaml
      python -c "from icutwin.tokenizer.cli import main; main()" pipeline site.yaml                   # -> /store/stage/tokenized_output
      python -c "from icutwin.scoring.winnower import main; main()" tokenized_output
      # the stage vocabulary must equal the training one, or the token ids would not match the model
      cmp /store/stage/tokenized_output/vocab.yaml /data/tokenized_output/vocab.yaml && echo "vocab: identical"
      echo "stage rooms: $(($(wc -l < /store/stage/stage_ward.csv) - 1))"

  extract:
    depends-on: [{name: tokens, status: FINISHED}]
    image: {uri: "docker://nvcr.io/nvidia/pytorch:25.11-py3"}
    # No `exclusive` (it reserves the whole node in Fuzzball 4.3, workflow-syntax): a refit can then run on the
    # free GPU while t7-twin is up. The GPU request alone takes the node's only GPU (docs/COMPUTE_PLAN.md).
    resource: {cpu: {cores: 16}, memory: {size: 100GB}, devices: {nvidia.com/gpu: 1}}
    policy: {timeout: {execute: 2h}}
    script: |
      #!/bin/bash
      set -euo pipefail
      python -c "from icutwin.scoring.extractor import main; main()" /store/train -m /data/model_output/final
      ls /store/train/features-*.parquet | wc -l

  fit:
    depends-on: [{name: extract, status: FINISHED}, {name: stage, status: FINISHED}]
    image: {uri: "docker://nvcr.io/nvidia/pytorch:25.11-py3"}
    resource: {cpu: {cores: 16}, memory: {size: 64GB}}
    policy: {timeout: {execute: 1h}}
    script: |
      #!/bin/bash
      set -euo pipefail
      # fits one probe per task on the train features, scores held_out; writes /store/train/probe-final.joblib (+ .meta.json: weights checksum)
      python -c "from icutwin.scoring.rep_based import main; main()" /store/train -m /data/model_output/final \
        -c /store/code/examples/probe_tasks.yaml
      python -c "import joblib; print('probes saved:', len(joblib.load('/store/train/probe-final.joblib')))"
