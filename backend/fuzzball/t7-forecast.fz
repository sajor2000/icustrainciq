version: v4
# t7-forecast: one update of the board's forecast. TEMPLATE: Fuzzball 4.3 Fuzzfiles have no parameters
# and `workflow start` has no --set (checked against docs.ciq.com/fuzzball/4.3, workflow-syntax and
# `fuzzball workflow start --help`), so app/dispatcher.py renders a copy per run, replacing
#   @SCOPE@  unit | room       @ROOM@  1..25 (0 for unit)       @HOURS@  demo-clock hours past the 07:00 cut
#   @WARD_FLAG@  empty = the open demo ward (default); "--real-ward" only when lane 2 started the dispatcher
#                with --real-ward (real MIMIC-IV room views, local only; docs/DECISIONS.md D6)
# and starts that copy (docs/DECISIONS.md D9). By hand: replace the four tokens first, e.g.
#   sed 's/@SCOPE@/unit/;s/@ROOM@/0/;s/@HOURS@/0/;s/@WARD_FLAG@//' fuzzball/t7-forecast.fz > /tmp/f.fz && fuzzball workflow start /tmp/f.fz
# A room run needs a whole-ward rooms.json (rooms.py refuses otherwise; the dispatcher refuses first).
# Jobs: precheck (CPU: probes and stage tokens exist) -> extract (one GPU) -> score (CPU).
#
# unit: extract the stage ward, apply the SAVED probes (never refit; fitting is t7-fit, once after t7-build),
#       write rooms.json, then forecast.json last (the commit marker the page watches).
# room: same extract (model load dominates; icutwin-extract has no stay filter), apply probes to that one
#       room's stay, rewrite that room in rooms.json. forecast.json is untouched.
# One GPU for minutes beside t7-twin (Nemotron holds the other). Counts and open-demo room files only
# leave the cluster volumes; nothing here prints a row.
volumes:
  store:
    name: twin-store            # model, probes, code, forecast.json, rooms.json, capacity.json
    use: team7
  rows:
    name: clif_work             # restricted: tokens, per-stay scores, stage/ (open demo patients)
    use: team7
  tooling:
    name: tooling               # pip target /tooling/py (deps installed once by t7-build)
    use: team7

defaults:
  job:
    mounts: {/store: store, /rows: rows, /tooling: tooling}
    env: [HOME=/tmp, TMPDIR=/tmp, "PYTHONPATH=/tooling/py:/store/code"]

jobs:
  precheck:
    # CPU: fail in seconds, before anything holds the GPU, if the one-time steps (t7-fit) have not run
    image: {uri: "docker://python:3.12-slim"}
    resource: {cpu: {cores: 1}, memory: {size: 1GB}}
    policy: {timeout: {execute: 5m}}
    script: |
      #!/bin/bash
      set -euo pipefail
      test -f /store/probes/mdl-icutwin/manifest.json || { echo "no saved probes: run t7-fit first"; exit 1; }
      test -d /rows/stage/tokenized_output || { echo "no stage ward tokens: run t7-fit first"; exit 1; }
      test -f /rows/stage/stage_ward.csv || { echo "no stage ward list: run t7-fit first"; exit 1; }
      test -d /store/model/mdl-icutwin || { echo "no model: run t7-build first"; exit 1; }
      echo "prechecks ok"

  extract:
    # one forward pass per stage-ward stay (about 100 short passes): icutwin's last hidden state at the cut
    depends-on: [{name: precheck, status: FINISHED}]
    image: {uri: "docker://nvcr.io/nvidia/pytorch:25.11-py3"}
    resource: {cpu: {cores: 16}, memory: {size: 100GB}, devices: {nvidia.com/gpu: 1}, exclusive: true}
    policy: {timeout: {execute: 30m}}
    script: |
      #!/bin/bash
      set -euo pipefail
      HOURS=@HOURS@
      # re-winnow the stage ward at the demo-clock cut (07:00 run: 0 h); writes the at-cut flags too
      python -c "from icutwin.scoring.winnower import main; main()" /rows/stage/tokenized_output \
        -c /store/code/examples/winnow_24h.yaml --demo-clock-hours "$HOURS"
      # every cut moved, so the whole ward is re-extracted (about 100 short passes)
      python -c "from icutwin.scoring.extractor import main; main()" /rows/stage/tokenized_output -m /store/model/mdl-icutwin
      ls /rows/stage/tokenized_output/features-*.parquet | wc -l

  score:
    # CPU: apply the saved probes, then rooms.json, then (unit only) forecast.json. The pytorch image is
    # needed because icutwin.common imports transformers; deps come from /tooling/py (no pip at run time).
    depends-on: [{name: extract, status: FINISHED}]
    image: {uri: "docker://nvcr.io/nvidia/pytorch:25.11-py3"}
    resource: {cpu: {cores: 4}, memory: {size: 16GB}}
    policy: {timeout: {execute: 20m}}
    script: |
      #!/bin/bash
      set -euo pipefail
      SCOPE=@SCOPE@; ROOM=@ROOM@; HOURS=@HOURS@
      WARD="@WARD_FLAG@"   # empty: open demo ward; --real-ward: real MIMIC-IV rooms (opt-in, local only)
      STAGE=/rows/stage/tokenized_output
      # rooms.py applies the saved probes (never refits) and writes rooms.json; ids stay on the volume
      COMMON="--model /store/model/mdl-icutwin --probes /store/probes/mdl-icutwin --stay-ids /rows/stage/stage_ward.csv --out /store/rooms.json --demo-clock-hours $HOURS --demographics /store/code/clif_demo --clif-now /store/code/clif_demo --tz America/Chicago $WARD"
      if [ "$SCOPE" = "room" ]; then
        python /store/code/app/rooms.py $STAGE $COMMON --room "$ROOM"   # this room only; the header keeps the unit numbers
      else
        python /store/code/app/rooms.py $STAGE $COMMON
        CAP=""; test -f /store/capacity.json && CAP="--capacity /store/capacity.json"
        python /store/code/app/aggregate.py $STAGE /store/forecast.json --beds 25 --score rep \
          --baseline /rows/tokenized_output --stage-csv /rows/stage/stage_ward.csv --demo-clock-hours "$HOURS" --clif-now /store/code/clif_demo --tz America/Chicago $WARD $CAP
        python -c "import json; d=json.load(open('/store/forecast.json')); print('made_at', d.get('made_at'), 'rows', len(d.get('resources', {})))"
      fi
